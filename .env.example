# Django Configuration
DEBUG=True
SECRET_KEY=django-insecure-hyperlocal-microclimate-capstone-key-2026-strathmore
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL + PostGIS + TimescaleDB)
# Set USE_SQLITE=True if Docker / PostgreSQL is not active locally for instant offline execution
USE_SQLITE=False
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=hyperlocal_weather
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis & Cache
REDIS_URL=redis://127.0.0.1:6379/0

# External Meteorological APIs
# Open-Meteo (https://open-meteo.com) — free, no API key required.
# ERA5 historical reanalysis + 7-day hourly forecasts, global coverage.
# No configuration needed; the WeatherDataIngester uses it automatically.

# Machine Learning Paths
ML_MODELS_DIR=ml_engine/weights/

